// ==================== Security Tools ====================
const SECURITY = {
  _salt: null,
  getSalt: function() {
    if (!this._salt) {
      const props = PropertiesService.getScriptProperties();
      let salt = props.getProperty("PASSWORD_SALT");
      if (!salt) {
        salt = Utilities.getUuid() + Utilities.getUuid();
        props.setProperty("PASSWORD_SALT", salt);
      }
      this._salt = salt;
    }
    return this._salt;
  },
  hashPassword: function(password) {
    const salt = this.getSalt();
    const raw = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, password + salt, Utilities.Charset.UTF_8);
    return raw.map(function(b) { return (b < 0 ? b + 256 : b).toString(16).padStart(2, "0"); }).join("");
  },
  verifyPassword: function(password, hash) { return this.hashPassword(password) === hash; },
  validateSymbol: function(symbol) { return /^[A-Z0-9]{2,20}USDT$/.test(symbol); },
  sanitizeString: function(str, maxLen) {
    return String(str || "").substring(0, maxLen || 200).replace(/[\x00-\x1F\x7F]/g, "");
  }
};

// ==================== Device Fingerprint Management ====================
const DeviceManager = {
  getSheet: function(ss) {
    let sheet = ss.getSheetByName(SHEETS.DEVICES);
    if (!sheet) { sheet = ss.insertSheet(SHEETS.DEVICES); sheet.appendRow(DEVICE_HEADERS); }
    return sheet;
  },
  checkDevice: function(ss, deviceId, username) {
    if (!deviceId) return { allowed: true };
    const sheet = this.getSheet(ss);
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      const now = new Date();
      const lockUntil = new Date(now.getTime() + CONFIG.DEVICE_LOCK_DAYS * 24 * 60 * 60 * 1000);
      sheet.appendRow([deviceId, username, now, now, "ACTIVE", lockUntil]);
      return { allowed: true };
    }
    const data = sheet.getRange(2, 1, lastRow - 1, 6).getValues();
    const now = new Date();
    const deviceKey = deviceId.toLowerCase().trim();
    for (let i = 0; i < data.length; i++) {
      const existingId = String(data[i][0] || "").toLowerCase().trim();
      if (existingId !== deviceKey) continue;
      const existingUser = String(data[i][1] || "").toLowerCase().trim();
      const lockUntil = data[i][5] instanceof Date ? data[i][5] : null;
      if (lockUntil && lockUntil > now && existingUser !== username.toLowerCase()) {
        const daysLeft = Math.ceil((lockUntil - now) / (1000 * 60 * 60 * 24));
        return { allowed: false, message: "Is device par pehle hi account register hai. " + daysLeft + " din baad dobara koshish karein.", existingUser: data[i][1] };
      }
      sheet.getRange(i + 2, 4).setValue(now);
      if (existingUser === username.toLowerCase()) {
        sheet.getRange(i + 2, 6).setValue(new Date(now.getTime() + CONFIG.DEVICE_LOCK_DAYS * 24 * 60 * 60 * 1000));
      }
      return { allowed: true };
    }
    const lockUntilNew = new Date(now.getTime() + CONFIG.DEVICE_LOCK_DAYS * 24 * 60 * 60 * 1000);
    sheet.appendRow([deviceId, username, now, now, "ACTIVE", lockUntilNew]);
    return { allowed: true };
  },
  unlockDevice: function(ss, deviceId) {
    const sheet = this.getSheet(ss);
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return false;
    const data = sheet.getRange(2, 1, lastRow - 1, 6).getValues();
    for (let i = 0; i < data.length; i++) {
      if (String(data[i][0] || "").toLowerCase().trim() === String(deviceId).toLowerCase().trim()) {
        sheet.getRange(i + 2, 6).setValue(new Date(0));
        return true;
      }
    }
    return false;
  }
};

