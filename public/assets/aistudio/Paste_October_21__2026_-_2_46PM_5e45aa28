// ==================== Outcome Tracking ====================
function checkAndUpdateOutcomes() {
  const ss = getSpreadsheet();
  const sheet = getOrCreateJournalSheet(ss);
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;
  const numCols = JOURNAL_HEADERS.length;
  const values = sheet.getRange(2, 1, lastRow - 1, numCols).getValues();
  const now = new Date();
  for (let i = 0; i < values.length; i++) {
    const row = values[i];
    const direction = String(row[COL.DIRECTION - 1] || "");
    const outcome = String(row[COL.OUTCOME - 1] || "").toUpperCase();
    if (direction !== "LONG" && direction !== "SHORT") continue;
    if (outcome !== "OPEN" && outcome !== "") continue;
    const timestamp = row[COL.TIMESTAMP - 1];
    const symbol = String(row[COL.SYMBOL - 1] || "");
    const timeframe = String(row[COL.TIMEFRAME - 1] || "1h");
    const entry = Number(row[COL.ENTRY - 1]);
    const stopLoss = Number(row[COL.STOPLOSS - 1]);
    const takeProfit = Number(row[COL.TAKEPROFIT - 1]);
    if (!symbol || !validPositive(entry) || !validPositive(stopLoss) || !validPositive(takeProfit)) continue;
    try {
      const result = evaluateSignalOutcome(symbol, timeframe, timestamp, direction, stopLoss, takeProfit, now);
      if (result.outcome !== "OPEN") sheet.getRange(i + 2, COL.OUTCOME, 1, 3).setValues([[result.outcome, result.closedPrice, result.closedTime]]);
    } catch (e) {}
  }
}

function evaluateSignalOutcome(symbol, timeframe, signalTime, direction, stopLoss, takeProfit, now) {
  const startTime = new Date(signalTime).getTime();
  const endTime = now.getTime();
  const hoursElapsed = (endTime - startTime) / (1000 * 60 * 60);
  if (hoursElapsed > CONFIG.MAX_HOLD_HOURS) return { outcome: "EXPIRED", closedPrice: 0, closedTime: now.toISOString() };
  try {
    const baseCoin = symbol.replace(/USDT$/, "").replace(/USD$/, "");
    const apiKey = PropertiesService.getScriptProperties().getProperty("CRYPTOCOMPARE_API_KEY");
    if (!apiKey) { Logger.log("CRYPTOCOMPARE_API_KEY set nahi hai"); return { outcome: "OPEN" }; }
    let endpoint = "histohour";
    if (timeframe === "15m") endpoint = "histominute";
    else if (timeframe === "4h") endpoint = "histohour";
    const url = "https://min-api.cryptocompare.com/data/v2/" + endpoint + "?fsym=" + baseCoin + "&tsym=USDT&limit=2000&toTs=" + Math.floor(endTime / 1000) + "&api_key=" + apiKey;
    const response = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
    if (response.getResponseCode() !== 200) { Logger.log("CryptoCompare fail for " + symbol + ": " + response.getResponseCode()); return { outcome: "OPEN" }; }
    const json = JSON.parse(response.getContentText());
    if (!json || !json.Data || !json.Data.Data || json.Data.Data.length === 0) { Logger.log("CryptoCompare data empty for " + symbol); return { outcome: "OPEN" }; }
    const candles = json.Data.Data;
    const signalTimeSec = Math.floor(startTime / 1000);
    for (let i = 0; i < candles.length; i++) {
      const candle = candles[i];
      if (candle.time < signalTimeSec) continue;
      const high = Number(candle.high), low = Number(candle.low);
      const closeTime = new Date(candle.time * 1000).toISOString();
      if (direction === "LONG") {
        if (low <= stopLoss) return { outcome: "LOSS", closedPrice: stopLoss, closedTime: closeTime };
        if (high >= takeProfit) return { outcome: "WIN", closedPrice: takeProfit, closedTime: closeTime };
      } else if (direction === "SHORT") {
        if (high >= stopLoss) return { outcome: "LOSS", closedPrice: stopLoss, closedTime: closeTime };
        if (low <= takeProfit) return { outcome: "WIN", closedPrice: takeProfit, closedTime: closeTime };
      }
    }
    return { outcome: "OPEN" };
  } catch (e) { Logger.log("evaluateSignalOutcome error: " + e.message); return { outcome: "OPEN" }; }
}

// ==================== Accuracy Report ====================
function getAccuracyReport() {
  const ss = getSpreadsheet();
  const sheet = getOrCreateJournalSheet(ss);
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return { totalClosed: 0, wins: 0, losses: 0, expired: 0, winRate: 0, byConfidenceBucket: {} };
  const values = sheet.getRange(2, 1, lastRow - 1, JOURNAL_HEADERS.length).getValues();
  let wins = 0, losses = 0, expired = 0;
  const byConfidenceBucket = {};
  values.forEach(function(row) {
    const outcome = String(row[COL.OUTCOME - 1] || "").toUpperCase();
    const confidence = Number(row[COL.CONFIDENCE - 1]) || 0;
    if (outcome === "WIN" || outcome === "LOSS") {
      let bucket;
      if (confidence >= 70) bucket = "70+"; else if (confidence >= 60) bucket = "60-69"; else if (confidence >= 55) bucket = "55-59"; else bucket = "under-55";
      if (!byConfidenceBucket[bucket]) byConfidenceBucket[bucket] = { wins: 0, total: 0 };
      byConfidenceBucket[bucket].total++;
      if (outcome === "WIN") { wins++; byConfidenceBucket[bucket].wins++; } else losses++;
    } else if (outcome === "EXPIRED") expired++;
  });
  Object.keys(byConfidenceBucket).forEach(function(bucket) {
    const b = byConfidenceBucket[bucket];
    b.winRate = b.total > 0 ? Math.round((b.wins / b.total) * 1000) / 10 : 0;
  });
  const totalClosed = wins + losses;
  return { totalClosed: totalClosed, wins: wins, losses: losses, expired: expired, winRate: totalClosed > 0 ? Math.round((wins / totalClosed) * 1000) / 10 : 0, byConfidenceBucket: byConfidenceBucket };
}

