function calculateSignalQuality(market, direction) {
  if (!direction || direction === "NO_TRADE") return { quality: "N/A", score: 0, maxScore: 5, details: "NO_TRADE — quality not applicable" };
  let score = 0;
  const details = [];
  const macd = market.macd || 0, macdSignal = market.macdSignal || 0, macdHist = market.macdHistogram || 0;
  if (direction === "LONG") {
    if (macd > macdSignal && macdHist > 0) { score += 1; details.push("MACD bullish aligned"); } else { details.push("MACD not aligned"); }
  } else if (direction === "SHORT") {
    if (macd < macdSignal && macdHist < 0) { score += 1; details.push("MACD bearish aligned"); } else { details.push("MACD not aligned"); }
  }
  const currentPrice = market.currentPrice || 0, ema20 = market.ema20 || 0, ema50 = market.ema50 || 0;
  if (direction === "LONG") {
    if (currentPrice > ema20 && ema20 > ema50) { score += 1; details.push("EMA bullish aligned"); }
    else if (currentPrice > ema20) { details.push("EMA partially aligned"); } else { details.push("EMA not aligned"); }
  } else if (direction === "SHORT") {
    if (currentPrice < ema20 && ema20 < ema50) { score += 1; details.push("EMA bearish aligned"); }
    else if (currentPrice < ema20) { details.push("EMA partially aligned"); } else { details.push("EMA not aligned"); }
  }
  const candles = market.recentCandles || [];
  let structureAligned = false;
  if (candles.length >= 6) {
    const recent = candles.slice(-6);
    const lows = recent.map(function(c) { return getCandleHL(c).l; });
    const highs = recent.map(function(c) { return getCandleHL(c).h; });
    if (direction === "LONG") {
      const lastLow = lows[lows.length - 1], prevLow = lows[lows.length - 3];
      structureAligned = lastLow > prevLow && lastLow > 0 && prevLow > 0;
    } else if (direction === "SHORT") {
      const lastHigh = highs[highs.length - 1], prevHigh = highs[highs.length - 3];
      structureAligned = lastHigh < prevHigh && lastHigh > 0 && prevHigh > 0;
    }
  }
  if (structureAligned) { score += 1; details.push("Structure aligned"); } else { details.push("Structure not aligned"); }
  const volumeRatio = market.volumeRatio || 0;
  if (volumeRatio >= 1.2) { score += 1; details.push("Strong volume"); }
  else if (volumeRatio >= 0.8) { details.push("Moderate volume"); } else { details.push("Weak volume"); }
  const adx = market.adx || 0;
  if (adx >= 25) { score += 1; details.push("Strong trend (ADX)"); }
  else if (adx >= 20) { details.push("Moderate trend"); } else { details.push("Weak trend"); }
  let quality = "WEAK";
  if (score >= 4) quality = "STRONG"; else if (score >= 2) quality = "MODERATE"; else quality = "WEAK";
  return { quality: quality, score: score, maxScore: 5, details: details.join(", ") };
}

function calculateRSIZonePenalty(market, direction) {
  if (!direction || direction === "NO_TRADE") return { penalty: 0, zone: "N/A", reason: "" };
  const rsi = market.rsi || 50;
  if (direction === "SHORT") {
    if (rsi > 0 && rsi < 20) return { penalty: 20, zone: "EXTREME_OVERSOLD", reason: "RSI < 20 (extreme oversold) — SHORT lena exhaust risk hai" };
    else if (rsi >= 20 && rsi < 30) return { penalty: 10, zone: "OVERSOLD", reason: "RSI 20-30 (oversold) — SHORT chase karna risky hai" };
    else if (rsi >= 30 && rsi < 35) return { penalty: 5, zone: "APPROACHING_OVERSOLD", reason: "RSI 30-35 (approaching oversold) — savdhani rakhein" };
  } else if (direction === "LONG") {
    if (rsi > 80 && rsi <= 100) return { penalty: 20, zone: "EXTREME_OVERBOUGHT", reason: "RSI > 80 (extreme overbought) — LONG lena exhaust risk hai" };
    else if (rsi > 70 && rsi <= 80) return { penalty: 10, zone: "OVERBOUGHT", reason: "RSI 70-80 (overbought) — LONG chase karna risky hai" };
    else if (rsi > 65 && rsi <= 70) return { penalty: 5, zone: "APPROACHING_OVERBOUGHT", reason: "RSI 65-70 (approaching overbought) — savdhani rakhein" };
    else if (rsi > 0 && rsi < 20) return { penalty: 20, zone: "EXTREME_OVERSOLD", reason: "RSI < 20 (extreme oversold) — LONG lena risky hai, bounce possible" };
    else if (rsi >= 20 && rsi < 30) return { penalty: 10, zone: "OVERSOLD", reason: "RSI 20-30 (oversold) — LONG chase karna risky hai" };
    else if (rsi >= 30 && rsi < 35) return { penalty: 5, zone: "APPROACHING_OVERSOLD", reason: "RSI 30-35 (approaching oversold) — savdhani rakhein" };
  }
  return { penalty: 0, zone: "NORMAL", reason: "" };
}

function calculateMarketStructure(market, direction) {
  let support = validPositive(market.support) ? market.support : 0;
  let resistance = validPositive(market.resistance) ? market.resistance : 0;
  let source = "market-data";
  if (support <= 0 && validPositive(market.tf2.support)) { support = market.tf2.support; source = "higher-timeframe"; }
  if (resistance <= 0 && validPositive(market.tf2.resistance)) { resistance = market.tf2.resistance; source = "higher-timeframe"; }
  if (support <= 0 && validPositive(market.tf3.support)) { support = market.tf3.support; source = "higher-timeframe"; }
  if (resistance <= 0 && validPositive(market.tf3.resistance)) { resistance = market.tf3.resistance; source = "higher-timeframe"; }
  if (support <= 0 && validPositive(market.ema50) && market.ema50 < market.currentPrice) { support = market.ema50; source = "ema-fallback"; }
  if (resistance <= 0 && validPositive(market.ema50) && market.ema50 > market.currentPrice) { resistance = market.ema50; source = "ema-fallback"; }
  if (direction === "LONG" && resistance > 0 && resistance <= market.currentPrice) resistance = 0;
  if (direction === "SHORT" && support > 0 && support >= market.currentPrice) support = 0;
  return { support: support, resistance: resistance, source: source };
}

function calculateTechnicalConfidence(market, direction, structure, trade) {
  let score = 50;
  const macdHist = market.macdHistogram || 0;
  const macdHistAbs = Math.abs(macdHist);
  if (direction === "LONG") {
    if (market.macd > market.macdSignal) { score += 8; if (macdHist > 0) score += 3; }
    else if (market.macd < market.macdSignal) { score -= 8; if (macdHist < 0 && macdHistAbs < Math.abs(market.macd * 0.5)) score += 3; }
  } else if (direction === "SHORT") {
    if (market.macd < market.macdSignal) { score += 8; if (macdHist < 0) score += 3; }
    else if (market.macd > market.macdSignal) { score -= 8; if (macdHist > 0 && macdHistAbs < Math.abs(market.macd * 0.5)) score += 3; }
  }
  if (direction === "LONG" && market.currentPrice > market.ema20 && market.ema20 > market.ema50) score += 8;
  if (direction === "SHORT" && market.currentPrice < market.ema20 && market.ema20 < market.ema50) score += 8;
  if (market.adx >= 25) score += 8; else if (market.adx >= 20) score += 3; else if (market.adx > 0) score -= 8;
  if (market.volumeRatio >= 1.20) score += 8; else if (market.volumeRatio >= 0.80) score += 3; else if (market.volumeRatio < 0.50 && market.volumeRatio > 0) score -= 10;
  if (direction === "LONG") { if (market.rsi >= 50 && market.rsi <= 65) score += 5; }
  else if (direction === "SHORT") { if (market.rsi >= 35 && market.rsi <= 50) score += 5; }
  if (trade.rr >= 2) score += 5; else if (trade.rr < 1) score -= 10;
  const tf2Bullish = (market.tf2 && market.tf2.ema20 > market.tf2.ema50);
  const tf2Bearish = (market.tf2 && market.tf2.ema20 < market.tf2.ema50);
  if (direction === "LONG" && tf2Bearish) score -= 5;
  if (direction === "SHORT" && tf2Bullish) score -= 5;
  return clamp(Math.round(score), 15, 95);
}

function calculateFinalConfidence(aiConfidence, technicalConfidence, market, direction, trade, structure) {
  let confidence = (aiConfidence * 0.50) + (technicalConfidence * 0.50);
  if (market.adx > 0 && market.adx < 15) confidence -= 5;
  if (market.volumeRatio > 0 && market.volumeRatio < 0.40) confidence -= 6;
  if (trade.rr < 1) confidence -= 8;
  return clamp(Math.round(confidence), 20, 95);
}

function buildReasoning(market, direction, structure, trade, aiReasoning, technicalFallback) {
  if (technicalFallback) {
    if (direction === "LONG") return "Technical fallback ne bullish tasdeeq ki bunyad par LONG muntakhib kiya. " + aiReasoning;
    if (direction === "SHORT") return "Technical fallback ne bearish tasdeeq ki bunyad par SHORT muntakhib kiya. " + aiReasoning;
    return "Market ghair mustahkam hai. NO_TRADE. " + aiReasoning;
  }
  return aiReasoning || ("Simt " + direction + " ki tasdeeq ho gayi.");
}

function buildWarnings(market, direction) {
  const warnings = [];
  const volatilityPercent = market.currentPrice > 0 ? (market.atr / market.currentPrice) * 100 : 0;
  if (volatilityPercent > 2.0) warnings.push("[RISK MANAGEMENT] Zyada utar charhao (" + volatilityPercent.toFixed(1) + "%). Leverage 3x-5x rakhein aur 50% margin istemal karein.");
  else if (volatilityPercent < 0.5 && volatilityPercent > 0) warnings.push("[RISK MANAGEMENT] Kam utar charhao. Market sideways hai, trailing SL zaroor istemal karein.");
  if (market.news && market.news !== "No recent major macro news detected.") warnings.push("[NEWS RADAR] Haal ki exchange announcements market trend par asar daal sakti hain.");
  if (market.volumeRatio > 0 && market.volumeRatio < 0.50) warnings.push("[WARNING] Volume ausat se kam hai (" + market.volumeRatio.toFixed(2) + "x).");
  if (market.adx > 0 && market.adx < 20) warnings.push("[WARNING] ADX < 20. Trend ki raftaar kamzor hai.");
  return warnings;
}

