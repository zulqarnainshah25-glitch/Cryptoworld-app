function detectBreakouts(market) {
  const none = { LONG: null, SHORT: null };
  if (!CONFIG.BREAKOUT_MODE) return none;
  try {
    const raw = market.recentCandles || [];
    const cs = [];
    raw.forEach(function(c) {
      let h, l, cl, v;
      if (Array.isArray(c)) { h = Number(c[2]); l = Number(c[3]); cl = Number(c[4]); v = Number(c[5]); }
      else if (c && typeof c === "object") { h = Number(c.high || c.h); l = Number(c.low || c.l); cl = Number(c.close || c.c); v = Number(c.volume || c.v || 0); }
      if (h > 0 && l > 0 && cl > 0) cs.push({ h: h, l: l, c: cl, v: Number.isFinite(v) ? v : 0 });
    });
    const n = cs.length;
    const age = CONFIG.BREAKOUT_MAX_AGE;
    if (n < 30) return none;
    const K = 2;
    const base = cs[n - age - 1];
    const hist = cs.slice(0, n - age);
    const lastClose = cs[n - 1].c;
    const price = Number(market.currentPrice) || lastClose;
    const pivH = [], pivL = [];
    for (let i = K; i < hist.length - K; i++) {
      let isH = true, isL = true;
      for (let j = 1; j <= K; j++) {
        if (hist[i].h <= hist[i - j].h || hist[i].h <= hist[i + j].h) isH = false;
        if (hist[i].l >= hist[i - j].l || hist[i].l >= hist[i + j].l) isL = false;
      }
      if (isH) pivH.push(hist[i].h);
      if (isL) pivL.push(hist[i].l);
    }
    function volRatioAt(b) {
      const from = Math.max(0, b - 20);
      const prev = cs.slice(from, b);
      if (prev.length < 5) return 0;
      const avg = prev.reduce(function(a, x) { return a + x.v; }, 0) / prev.length;
      return avg > 0 ? cs[b].v / avg : 0;
    }
    const out = { LONG: null, SHORT: null };
    const upLevels = pivH.filter(function(p) { return base.c <= p && p < lastClose; });
    if (upLevels.length && price > Math.max.apply(null, upLevels)) {
      const level = Math.max.apply(null, upLevels);
      let b = -1;
      for (let i = n - age; i < n; i++) { if (cs[i].c > level) { b = i; break; } }
      if (b >= 0) { const vr = volRatioAt(b); if (vr >= CONFIG.BREAKOUT_VOL) out.LONG = { level: level, volRatio: vr, age: n - 1 - b }; }
    }
    const dnLevels = pivL.filter(function(p) { return base.c >= p && p > lastClose; });
    if (dnLevels.length && price < Math.min.apply(null, dnLevels)) {
      const level = Math.min.apply(null, dnLevels);
      let b = -1;
      for (let i = n - age; i < n; i++) { if (cs[i].c < level) { b = i; break; } }
      if (b >= 0) { const vr = volRatioAt(b); if (vr >= CONFIG.BREAKOUT_VOL) out.SHORT = { level: level, volRatio: vr, age: n - 1 - b }; }
    }
    return out;
  } catch (e) { Logger.log("detectBreakouts error: " + e.message); return none; }
}

