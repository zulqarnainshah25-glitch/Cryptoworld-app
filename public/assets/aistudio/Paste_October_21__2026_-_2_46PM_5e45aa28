  if (existingCount < JOURNAL_HEADERS.length) {
    sheet.getRange(1, existingCount + 1, 1, JOURNAL_HEADERS.length - existingCount).setValues([JOURNAL_HEADERS.slice(existingCount)]);
  }
}

