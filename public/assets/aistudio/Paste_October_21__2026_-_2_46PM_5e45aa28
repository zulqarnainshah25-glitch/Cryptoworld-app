// ==================== GROQ AI ENGINE (Primary) ====================
function getGroqApiKey() {
  return PropertiesService.getScriptProperties().getProperty("GROQ_API_KEY");
}

function analyzeWithGroq(apiKey, market, symbol, timeframe) {
  const prompt = buildGroqPrompt(market, symbol, timeframe);
  let lastError = "";
  let totalAttempts = 0;
  for (let modelIndex = 0; modelIndex < CONFIG.GROQ_MODELS.length; modelIndex++) {
    const model = CONFIG.GROQ_MODELS[modelIndex];
    for (let retry = 0; retry < CONFIG.MODEL_RETRIES; retry++) {
      totalAttempts++;
      try {
        const response = callGroq(apiKey, model, prompt);
        let text = extractGroqText(response);
        if (!text) throw new Error("Groq ne khaali jawab diya.");
        text = text.trim().replace(/^```json\s*/i, "").replace(/^```\s*/i, "").replace(/\s*```$/i, "").trim();
        const firstBrace = text.indexOf("{");
        const lastBrace = text.lastIndexOf("}");
        if (firstBrace === -1 || lastBrace === -1) throw new Error("Groq response mein JSON nahi mila.");
        text = text.substring(firstBrace, lastBrace + 1);
        const parsed = JSON.parse(text);
        const direction = normalizeDirection(parsed.direction);
        if (!direction) throw new Error("Groq ne ghalat simt di.");
        let confidence = Number(parsed.confidence);
        if (!Number.isFinite(confidence)) confidence = 55;
        confidence = clamp(confidence, 20, 95);
        return {
          direction: direction, confidence: Math.round(confidence),
          reasoning: String(parsed.reasoning || "Groq analysis mukammal hua."),
          waitForPick: sanitizeWaitForPick(parsed.waitFor),
          model: model, attempts: totalAttempts, status: "GROQ_AI"
        };
      } catch (error) {
        lastError = String(error.message || error);
        const statusCode = extractHttpStatus(error);
        if (statusCode === 401 || statusCode === 403) {
          return { direction: null, confidence: 40, reasoning: "Groq API tasdeeq ki kharabi: " + lastError, model: model, attempts: totalAttempts, status: "GROQ_API_KEY_ERROR" };
        }
        if (statusCode === 429) { if (retry < CONFIG.MODEL_RETRIES - 1) { Utilities.sleep(2000); continue; } }
        if (isRetryableGroqError(statusCode, lastError)) {
          if (retry < CONFIG.MODEL_RETRIES - 1) { Utilities.sleep(CONFIG.RETRY_DELAYS[Math.min(retry, CONFIG.RETRY_DELAYS.length - 1)]); continue; }
        }
      }
    }
  }
  return { direction: null, confidence: 40, reasoning: "Groq fail. " + lastError, model: "groq-failed", attempts: totalAttempts, status: "GROQ_FAILED" };
}

function callGroq(apiKey, model, prompt) {
  const url = "https://api.groq.com/openai/v1/chat/completions";
  const payload = { model: model, messages: [{ role: "user", content: prompt }], temperature: 0.1, max_tokens: 2000 };
  const response = UrlFetchApp.fetch(url, {
    method: "post", contentType: "application/json",
    headers: { "Authorization": "Bearer " + apiKey },
    payload: JSON.stringify(payload), muteHttpExceptions: true
  });
  const status = response.getResponseCode();
  const body = response.getContentText();
  if (status < 200 || status >= 300) {
    const error = new Error("Groq HTTP " + status + ": " + body.substring(0, 800));
    error.httpStatus = status;
    throw error;
  }
  return JSON.parse(body);
}

function extractGroqText(response) {
  try { if (response && response.choices && response.choices.length > 0) return response.choices[0].message.content || ""; } catch (e) {}
  return "";
}

function isRetryableGroqError(statusCode, message) {
  if ([429, 500, 502, 503, 504].includes(statusCode)) return true;
  const text = String(message || "").toLowerCase();
  return (text.includes("rate limit") || text.includes("overloaded") || text.includes("temporarily unavailable"));
}

