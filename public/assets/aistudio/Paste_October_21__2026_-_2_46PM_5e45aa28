  const technicalConfidence = calculateTechnicalConfidence(market, direction, structure, trade);
  let finalConfidence = calculateFinalConfidence(aiResult.confidence, technicalConfidence, market, direction, trade, structure);

  const rsiPenaltyCheck = calculateRSIZonePenalty(market, direction);
