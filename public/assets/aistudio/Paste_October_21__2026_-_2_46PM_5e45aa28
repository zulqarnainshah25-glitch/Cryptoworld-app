function getUserQuotaRow(sheet, username) {
  const cache = CacheService.getScriptCache();
  const cacheKey = "user_" + username.toLowerCase();
  const cached = cache.get(cacheKey);
  if (cached) { try { const c = JSON.parse(cached); if (c && c.username) return c; } catch (e) {} }
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return null;
  const colMap = getQuotaColumnMap(sheet);
  const maxCol = Math.max(sheet.getLastColumn(), 1);
  const values = sheet.getRange(2, 1, lastRow - 1, maxCol).getValues();
  for (let i = 0; i < values.length; i++) {
    const u = String(values[i][0] || "").trim().toLowerCase();
    if (u === username.toLowerCase()) {
      const user = {
        row: i + 2, username: String(values[i][0] || "").trim(), password: String(values[i][1] || "").trim(),
        signalsLeft: Number(values[i][2]) || 0, lastUsed: values[i][3],
        referralCode: colMap.ReferralCode ? String(values[i][colMap.ReferralCode - 1] || "").trim() : "",
        referralCount: colMap.ReferralCount ? Number(values[i][colMap.ReferralCount - 1]) || 0 : 0,
        referralBonus: colMap.ReferralBonus ? Number(values[i][colMap.ReferralBonus - 1]) || 0 : 0,
        premiumPlan: colMap.PremiumPlan ? String(values[i][colMap.PremiumPlan - 1] || "").trim() : "",
        premiumExpiry: colMap.PremiumExpiry ? values[i][colMap.PremiumExpiry - 1] : null,
        premiumSignalsPerDay: colMap.PremiumSignalsPerDay ? Number(values[i][colMap.PremiumSignalsPerDay - 1]) || 0 : 0
      };
      cache.put(cacheKey, JSON.stringify(user), 60);
      return user;
    }
  }
  return null;
}

function updateUserCache(username, password, signalsLeft, lastUsed) {
  const cache = CacheService.getScriptCache();
  const user = { row: 0, username: username, password: password, signalsLeft: signalsLeft, lastUsed: lastUsed };
  cache.put("user_" + username.toLowerCase(), JSON.stringify(user), CONFIG.CACHE_TTL_USER);
}

function getAndUpdateUserQuota(sheet, username) {
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    const user = getUserQuotaRow(sheet, username);
    if (!user) return null;
    const colMap = getQuotaColumnMap(sheet);
    const today = Utilities.formatDate(new Date(), CONFIG.TIMEZONE, "yyyy-MM-dd");
    const lastUsedDate = normalizeSheetDate(user.lastUsed);
    let premiumActive = false, premiumPlan = "", premiumSignalsPerDay = 0;
    if (user.premiumPlan && user.premiumExpiry) {
      const expiry = user.premiumExpiry instanceof Date ? user.premiumExpiry : new Date(user.premiumExpiry);
      if (!isNaN(expiry.getTime()) && expiry > new Date()) {
        premiumActive = true; premiumPlan = user.premiumPlan; premiumSignalsPerDay = user.premiumSignalsPerDay || 0;
      }
    }
    const dailyQuota = premiumActive ? premiumSignalsPerDay : CONFIG.DEFAULT_DAILY_QUOTA;
    const totalAllowedToday = dailyQuota + (user.referralBonus || 0);
    let signals = Number.isFinite(user.signalsLeft) ? user.signalsLeft : totalAllowedToday;
    if (lastUsedDate && lastUsedDate !== today) {
      signals = totalAllowedToday;
      if (colMap.Signals_Left) sheet.getRange(user.row, colMap.Signals_Left).setValue(signals);
      if (colMap.Last_Used_Time) sheet.getRange(user.row, colMap.Last_Used_Time).setValue(new Date());
      CacheService.getScriptCache().remove("user_" + username.toLowerCase());
    }
    return {
      row: user.row, username: user.username, password: user.password, signalsLeft: signals, lastUsed: user.lastUsed,
      referralCode: user.referralCode, referralCount: user.referralCount, referralBonus: user.referralBonus,
      premiumActive: premiumActive, premiumPlan: premiumPlan, premiumSignalsPerDay: premiumSignalsPerDay
    };
  } finally { lock.releaseLock(); }
}

function normalizeSheetDate(value) {
  if (value instanceof Date) return Utilities.formatDate(value, CONFIG.TIMEZONE, "yyyy-MM-dd");
  const text = String(value || "").trim();
  if (/^\d{4}-\d{2}-\d{2}$/.test(text)) return text;
  const parsed = new Date(text);
  if (!isNaN(parsed.getTime())) return Utilities.formatDate(parsed, CONFIG.TIMEZONE, "yyyy-MM-dd");
  return "";
}

// ==================== Quota Consumption (FINAL - Guarded versions) ====================
function consumeQuota(sheet, userRow, currentSignals) {
  if (!userRow || userRow < 2) return 0;
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    const live = Number(sheet.getRange(userRow, 3).getValue());
    const base = Number.isFinite(live) ? live : currentSignals;
    const newSignals = Math.max(0, base - 1);
    sheet.getRange(userRow, 3, 1, 2).setValues([[newSignals, new Date()]]);
    const username = sheet.getRange(userRow, 1).getValue();
    CacheService.getScriptCache().remove("user_" + String(username).toLowerCase());
    return newSignals;
  } finally { lock.releaseLock(); }
}

function consumePartialQuota(sheet, userRow, currentSignals, cost) {
  if (!userRow || userRow < 2) return 0;
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    const live = Number(sheet.getRange(userRow, 3).getValue());
    const base = Number.isFinite(live) ? live : currentSignals;
    const newSignals = Math.max(0, base - cost);
    sheet.getRange(userRow, 3, 1, 2).setValues([[newSignals, new Date()]]);
    const username = sheet.getRange(userRow, 1).getValue();
    CacheService.getScriptCache().remove("user_" + String(username).toLowerCase());
    return newSignals;
  } finally { lock.releaseLock(); }
}

