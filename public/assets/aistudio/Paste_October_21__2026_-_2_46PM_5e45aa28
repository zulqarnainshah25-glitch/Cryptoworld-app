// ==================== Indicator Calculations ====================
function calculateRSI(closes, period) {
  period = period || 14;
  if (!closes || closes.length < period + 1) return 50;
  let gains = 0, losses = 0;
  for (let i = 1; i <= period; i++) {
    const change = closes[i] - closes[i - 1];
    if (change > 0) gains += change; else losses -= change;
  }
  let avgGain = gains / period, avgLoss = losses / period;
  for (let i = period + 1; i < closes.length; i++) {
    const change = closes[i] - closes[i - 1];
    const currentGain = change > 0 ? change : 0;
    const currentLoss = change < 0 ? -change : 0;
    avgGain = ((avgGain * (period - 1)) + currentGain) / period;
    avgLoss = ((avgLoss * (period - 1)) + currentLoss) / period;
  }
  if (avgLoss === 0) return 100;
  if (avgGain === 0) return 0;
  const rs = avgGain / avgLoss;
  return 100 - (100 / (1 + rs));
}

function calculateEMA(data, period) {
  if (!data || data.length === 0) return [0];
  const k = 2 / (period + 1);
  const emaArray = [data[0]];
  for (let i = 1; i < data.length; i++) emaArray.push(data[i] * k + emaArray[i - 1] * (1 - k));
  return emaArray;
}

function calculateMACD(closes) {
  if (!closes || closes.length < 35) return { macd: 0, signal: 0 };
  const ema12 = calculateEMA(closes, 12);
  const ema26 = calculateEMA(closes, 26);
  const macdLine = ema12.map(function(v, i) { return v - ema26[i]; });
  const signalSource = macdLine.slice(26);
  const signalLine = calculateEMA(signalSource, 9);
  return { macd: macdLine[macdLine.length - 1], signal: signalLine[signalLine.length - 1] };
}

function calculateATRAndADX(highs, lows, closes, period) {
  period = period || 14;
  if (!closes || closes.length < period * 2) return { atr: 0, adx: 25 };
  const tr = [], plusDM = [], minusDM = [];
  for (let i = 1; i < closes.length; i++) {
    const h = highs[i], l = lows[i], pc = closes[i - 1];
    tr.push(Math.max(h - l, Math.abs(h - pc), Math.abs(l - pc)));
    const upMove = h - highs[i - 1], downMove = lows[i - 1] - l;
    plusDM.push(upMove > downMove && upMove > 0 ? upMove : 0);
    minusDM.push(downMove > upMove && downMove > 0 ? downMove : 0);
  }
  function smooth(arr) {
    if (arr.length < period) return [];
    const result = [arr.slice(0, period).reduce(function(a, b) { return a + b; }, 0)];
    for (let i = period; i < arr.length; i++) result.push(result[result.length - 1] - (result[result.length - 1] / period) + arr[i]);
    return result;
  }
  const smoothedTR = smooth(tr), smoothedPlus = smooth(plusDM), smoothedMinus = smooth(minusDM);
  if (!smoothedTR.length) return { atr: 0, adx: 25 };
  const dx = [];
  for (let i = 0; i < smoothedTR.length; i++) {
    const diPlus = (smoothedPlus[i] / smoothedTR[i]) * 100 || 0;
    const diMinus = (smoothedMinus[i] / smoothedTR[i]) * 100 || 0;
    const sum = diPlus + diMinus;
    dx.push(sum > 0 ? (Math.abs(diPlus - diMinus) / sum) * 100 : 0);
  }
  const adxSmooth = smooth(dx);
  const adx = adxSmooth.length ? adxSmooth[adxSmooth.length - 1] / period : 25;
  const atr = smoothedTR[smoothedTR.length - 1] / period;
  return { atr: atr, adx: adx };
}

