// ==================== Registration ====================
function handleRegister(data) {
  const username = SECURITY.sanitizeString(data.username || data.userId || "", 50).trim();
  const password = String(data.password || "").trim();
  const deviceId = SECURITY.sanitizeString(data.deviceId || "", 128).trim();
  const referralCode = SECURITY.sanitizeString(data.referralCode || "", 30).trim().toUpperCase();
  if (!username || !password) return jsonResponse({ error: true, message: "Username aur Password dono darkar hain." });
  if (username.length < 3) return jsonResponse({ error: true, message: "Username kam az kam 3 harf ka hona chahiye." });
  if (password.length < 6) return jsonResponse({ error: true, message: "Password kam az kam 6 harf ka hona chahiye." });
  const ss = getSpreadsheet();
  const quotaSheet = getOrCreateQuotaSheet(ss);
  const existing = getUserQuotaRow(quotaSheet, username);
  if (existing) return jsonResponse({ error: true, message: "Ye username pehle se register hai." });
  if (deviceId) {
    const deviceCheck = DeviceManager.checkDevice(ss, deviceId, username);
    if (!deviceCheck.allowed) return jsonResponse({ error: true, message: deviceCheck.message, code: "DEVICE_LOCKED", existingUser: deviceCheck.existingUser || "" });
  }
  let referrerUser = null;
  if (referralCode) {
    const ownCode = generateReferralCode(username);
    if (referralCode === ownCode) return jsonResponse({ error: true, message: "Apna hi referral code istemal nahi kar sakte." });
    referrerUser = findUserByReferralCode(quotaSheet, referralCode);
    if (!referrerUser) return jsonResponse({ error: true, message: "Referral code ghalat hai." });
  }
  const hashedPassword = SECURITY.hashPassword(password);
  const myReferralCode = generateReferralCode(username);
  const colMap = getQuotaColumnMap(quotaSheet);
  const newRow = new Array(Math.max(quotaSheet.getLastColumn(), 1)).fill("");
  newRow[0] = username; newRow[1] = hashedPassword; newRow[2] = CONFIG.DEFAULT_DAILY_QUOTA; newRow[3] = new Date();
  if (colMap.ReferralCode) newRow[colMap.ReferralCode - 1] = myReferralCode;
  if (colMap.ReferralCount) newRow[colMap.ReferralCount - 1] = 0;
  if (colMap.ReferralBonus) newRow[colMap.ReferralBonus - 1] = 0;
  if (colMap.PremiumPlan) newRow[colMap.PremiumPlan - 1] = "";
  if (colMap.PremiumExpiry) newRow[colMap.PremiumExpiry - 1] = "";
  if (colMap.PremiumSignalsPerDay) newRow[colMap.PremiumSignalsPerDay - 1] = 0;
  quotaSheet.appendRow(newRow);
  if (referrerUser && referralCode) {
    const refSheet = getOrCreateReferralsSheet(ss);
    refSheet.appendRow([new Date(), referrerUser.username, referralCode, username, "PENDING", 0, deviceId]);
  }
  updateUserCache(username, hashedPassword, CONFIG.DEFAULT_DAILY_QUOTA, new Date());
  return jsonResponse({ error: false, success: true, username: username, userId: username, referralCode: myReferralCode, signalsLeft: CONFIG.DEFAULT_DAILY_QUOTA, quotaLimit: CONFIG.DEFAULT_DAILY_QUOTA });
}

function handleLogin(data) {
  const username = SECURITY.sanitizeString(data.username || data.userId || "", 50).trim();
  const password = String(data.password || "").trim();
  const deviceId = SECURITY.sanitizeString(data.deviceId || "", 128).trim();
  if (!username || !password) return jsonResponse({ error: true, message: "Username aur Password dono darkar hain." });
  const ss = getSpreadsheet();
  const quotaSheet = getOrCreateQuotaSheet(ss);
  const user = getAndUpdateUserQuota(quotaSheet, username);
  if (!user) return jsonResponse({ error: true, message: "Username nahi mila. Pehle register karein." });
  if (!SECURITY.verifyPassword(password, user.password)) return jsonResponse({ error: true, message: "Username ya password ghalat hai." });
  if (deviceId) DeviceManager.checkDevice(ss, deviceId, username);
  return jsonResponse({
    error: false, success: true, username: user.username, userId: user.username,
    signalsLeft: user.signalsLeft,
    quotaLimit: user.premiumActive ? user.premiumSignalsPerDay : CONFIG.DEFAULT_DAILY_QUOTA,
    referralCode: user.referralCode || generateReferralCode(user.username),
    referralCount: user.referralCount || 0, referralBonus: user.referralBonus || 0,
    premiumActive: user.premiumActive || false, premiumPlan: user.premiumPlan || "",
    premiumSignalsPerDay: user.premiumSignalsPerDay || 0
  });
}

function handleUnlockDevice(data) {
  const adminKey = String(data.adminKey || "").trim();
  const expectedKey = PropertiesService.getScriptProperties().getProperty("ADMIN_KEY");
  if (!expectedKey || adminKey !== expectedKey) return jsonResponse({ error: true, message: "Ghair mujaz darkhwast." });
  const deviceId = SECURITY.sanitizeString(data.deviceId || "", 128).trim();
  if (!deviceId) return jsonResponse({ error: true, message: "Device ID darkar hai." });
  const ss = getSpreadsheet();
  const ok = DeviceManager.unlockDevice(ss, deviceId);
  return jsonResponse({ error: !ok, message: ok ? "Device unlock ho gayi." : "Device nahi mili." });
}
// ==================== Signal Processing (Groq + Gemini) ====================
function handleSignal(data) {
  const username = SECURITY.sanitizeString(data.username || data.userId || "", 50).trim();
  const symbol = SECURITY.sanitizeString(data.symbol || "", 20).trim().toUpperCase();
  const timeframe = normalizeTF(data.timeframe || "1h");

  if (!username) return jsonResponse({ error: true, message: "Username darkar hai." });
  if (!symbol) return jsonResponse({ error: true, message: "Symbol darkar hai." });
  if (!SECURITY.validateSymbol(symbol)) {
    return jsonResponse({ error: true, message: "Ghalat symbol format. Misal: BTCUSDT" });
  }

  const geminiApiKey = getGeminiApiKey();
  const groqApiKey = getGroqApiKey();

  if (!geminiApiKey && !groqApiKey) {
    return jsonResponse({ error: true, message: "Koi AI API key set nahi hai." });
  }

  const ss = getSpreadsheet();
  const quotaSheet = getOrCreateQuotaSheet(ss);
  const journalSheet = getOrCreateJournalSheet(ss);
  const userQuota = getAndUpdateUserQuota(quotaSheet, username);

  if (!userQuota) return jsonResponse({ error: true, message: "User account nahi mila." });

  if (userQuota.signalsLeft <= 0) {
    return jsonResponse({
      error: true,
      message: "Aaj ki quota khatam ho gayi.",
      signalsLeft: 0,
      quotaLimit: CONFIG.DEFAULT_DAILY_QUOTA
    });
  }

  const market = normalizeMarketData(data, timeframe);
  market.timeframe = timeframe;
  if (!validPositive(market.currentPrice)) {
    return jsonResponse({ error: true, message: "Ghalat futures qeemat." });
  }

  market.news = fetchMarketNews();
  market.breakouts = detectBreakouts(market);

  let aiResult = null;

  if (groqApiKey) {
    aiResult = analyzeWithGroq(groqApiKey, market, symbol, timeframe);
    
    if (!aiResult.direction || aiResult.status === "GROQ_FAILED" || aiResult.status === "GROQ_API_KEY_ERROR") {
      Logger.log("Groq fail: " + aiResult.reasoning + " — Gemini try kar rahe hain...");
      
      if (geminiApiKey) {
        const geminiResult = analyzeWithGemini(geminiApiKey, market, symbol, timeframe);
        geminiResult.reasoning = "[Groq failed, Gemini fallback] " + geminiResult.reasoning;
        aiResult = geminiResult;
      }
    }
  } else if (geminiApiKey) {
    aiResult = analyzeWithGemini(geminiApiKey, market, symbol, timeframe);
  } else {
    aiResult = {
      direction: null, confidence: 40,
      reasoning: "Koi AI API available nahi.",
      model: "no-ai", attempts: 0, status: "NO_AI"
    };
  }

  let direction = normalizeDirection(aiResult.direction);
  market.waitForPick = aiResult.waitForPick || null;

  let technicalFallback = false;
  if (!direction || aiResult.status === "TECHNICAL_FALLBACK" || aiResult.status === "GROQ_FAILED") {
    direction = fallbackDirection(market);
    technicalFallback = true;
  }

  const warnings = buildWarnings(market, direction);

  if (technicalFallback) {
    warnings.push("[SYSTEM] AI APIs dastiyab nahi theen. Ye nateeja technical fallback se liya gaya. Wajah: " + aiResult.reasoning);
  } else {
    warnings.push("[AI STATUS] Market analysis kamyab, model: " + aiResult.model);
  }

  const rawMacroBull = (validPositive(market.tf2.ema20) && validPositive(market.tf2.ema50) && market.tf2.ema20 > market.tf2.ema50) ||
                      (validPositive(market.tf3.ema20) && validPositive(market.tf3.ema50) && market.tf3.ema20 > market.tf3.ema50);
  const rawMacroBear = (validPositive(market.tf2.ema20) && validPositive(market.tf2.ema50) && market.tf2.ema20 < market.tf2.ema50) ||
                      (validPositive(market.tf3.ema20) && validPositive(market.tf3.ema50) && market.tf3.ema20 < market.tf3.ema50);

  const isMacroBull = rawMacroBull && !rawMacroBear;
  const isMacroBear = rawMacroBear && !rawMacroBull;

  if (direction === "SHORT" && isMacroBull) warnings.push("[WARNING] Counter-Trend Scalp: Macro timeframe bullish hai.");
  else if (direction === "LONG" && isMacroBear) warnings.push("[WARNING] Counter-Trend Scalp: Macro timeframe bearish hai.");

  if (direction === "NO_TRADE" || (aiResult.direction === "NO_TRADE" && fallbackDirection(market) === "NO_TRADE")) {
    const remaining = consumePartialQuota(quotaSheet, userQuota.row, userQuota.signalsLeft, CONFIG.NO_TRADE_QUOTA_COST);

    return jsonResponse({
      error: false, success: true,
      username: username, symbol: symbol, timeframe: timeframe,
      direction: "NO_TRADE", signalDirection: "NEUTRAL",     
      currentPrice: market.currentPrice, entry: market.currentPrice,
      stopLoss: 0, takeProfit: 0, rr: "N/A",
      confidence: Math.min(aiResult.confidence || 30, 40),
      model: aiResult.model,
      warnings: warnings,
      reasoning: aiResult.reasoning || "Market ke halaat filhal wazeh nahi.",
      waitFor: calculateWaitFor(market, direction),
      signalsLeft: remaining
    });
  }

  const gateReasons = [];
  const boDir = (CONFIG.BREAKOUT_MODE && market.breakouts) ? market.breakouts[direction] : null;
  if (boDir) {
    warnings.push("[BREAKOUT] " + direction + " breakout confirm hai (level " + roundNumber(boDir.level, 6) +
                  ", volume " + boDir.volRatio.toFixed(2) + "x) — ADX gate nahi lagaya gaya.");
  }
  if (!boDir && market.adx > 0 && market.adx < CONFIG.MIN_ADX) {
    gateReasons.push("ADX " + market.adx.toFixed(1) + " (< " + CONFIG.MIN_ADX + ") — trend kamzor hai");
  }
  if (direction === "LONG" && market.rsi >= CONFIG.RSI_CHASE_LONG_MAX) {
    gateReasons.push("RSI " + market.rsi.toFixed(1) + " (>= " + CONFIG.RSI_CHASE_LONG_MAX + ") — LONG chase karna risky hai");
  }
  if (direction === "SHORT" && market.rsi > 0 && market.rsi <= CONFIG.RSI_CHASE_SHORT_MIN) {
    gateReasons.push("RSI " + market.rsi.toFixed(1) + " (<= " + CONFIG.RSI_CHASE_SHORT_MIN + ") — SHORT chase karna risky hai");
  }

  if (gateReasons.length > 0) {
    const remaining = consumePartialQuota(quotaSheet, userQuota.row, userQuota.signalsLeft, CONFIG.NO_TRADE_QUOTA_COST);
    const gateWaitDir = "WAIT_" + direction;
    const gateReasoning = direction + " bias hai lekin entry quality kamzor hai: " + gateReasons.join(" | ") +
                          ". Behtar setup ya pullback ka wait karein.";
    warnings.push("[QUALITY GATE] " + gateReasoning);

    const gateStructure = calculateMarketStructure(market, direction);
    const gateTrade = calculateSmartTradeLevels(market, direction, gateStructure, timeframe);

    return jsonResponse({
      error: false, success: true,
      username: username, symbol: symbol, timeframe: timeframe,
      direction: gateWaitDir,
      signalDirection: direction,
      entryStatus: "WAIT_PULLBACK",
      currentPrice: market.currentPrice,
      suggestedEntry: gateTrade.suggestedEntry || market.currentPrice,
      triggerPrice: gateTrade.triggerPrice || market.currentPrice,
      invalidationPrice: gateTrade.invalidationPrice || gateTrade.stopLoss,
      entry: null,
      stopLoss: 0, takeProfit: 0, rr: "N/A",
      confidence: 40,
      directionConfidence: aiResult.confidence || 60,
      entryConfidence: 35,
      signalQuality: "WAIT",
      signalQualityDetails: "Quality gate: " + gateReasons.join(", "),
      model: aiResult.model,
      warnings: warnings,
      reasoning: gateReasoning,
      waitFor: calculateWaitFor(market, direction),
      signalsLeft: remaining
    });
  }

  const htfCheck = detectHTFConflict(market, direction, isMacroBull, isMacroBear);
  const extCheck = detectOverextension(market, direction);
  const shouldWait = extCheck.overextended || (htfCheck.conflict && extCheck.candleExtension > 1.2);

  const rsiZone = calculateRSIZonePenalty(market, direction);
  const isOversoldOrOverbought = rsiZone.zone === "EXTREME_OVERSOLD" || 
                                  rsiZone.zone === "OVERSOLD" || 
                                  rsiZone.zone === "EXTREME_OVERBOUGHT" || 
                                  rsiZone.zone === "OVERBOUGHT";
  
  const isStrongHTFConflict = htfCheck.conflict && htfCheck.htfDisagreeCount >= 2;

  if (isStrongHTFConflict && direction !== "NO_TRADE") {
    const remaining = consumePartialQuota(quotaSheet, userQuota.row, userQuota.signalsLeft, CONFIG.NO_TRADE_QUOTA_COST);
    
    const strongWaitDir = direction === "SHORT" ? "WAIT_SHORT" : "WAIT_LONG";
    const strongReasoning = "Strong HTF conflict: " + htfCheck.reason + 
                            ". Counter-trend trade risk zyada hai. Confirmed continuation ka wait karein.";
    
    warnings.push("[STRONG HTF CONFLICT] " + strongReasoning);
    
    const strongStructure = calculateMarketStructure(market, direction);
    const strongTrade = calculateSmartTradeLevels(market, direction, strongStructure, timeframe);
    
    return jsonResponse({
      error: false, success: true,
      username: username, symbol: symbol, timeframe: timeframe,
      direction: strongWaitDir,
      signalDirection: direction,
      entryStatus: "WAIT_COUNTER_TREND",
      currentPrice: market.currentPrice,
      suggestedEntry: strongTrade.suggestedEntry || market.currentPrice,
      triggerPrice: strongTrade.triggerPrice || market.currentPrice,
      invalidationPrice: strongTrade.invalidationPrice || strongTrade.stopLoss,
      entry: null,
      stopLoss: 0, takeProfit: 0, rr: "N/A",
      confidence: 35,
      directionConfidence: aiResult.confidence || 60,
      entryConfidence: 30,
      signalQuality: "WAIT",
