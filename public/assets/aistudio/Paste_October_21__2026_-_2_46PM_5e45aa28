// ==================== Gemini Engine (Fallback) ====================
function analyzeWithGemini(apiKey, market, symbol, timeframe) {
  const prompt = buildGeminiPrompt(market, symbol, timeframe);
  let lastError = "";
  let totalAttempts = 0;
  for (let modelIndex = 0; modelIndex < CONFIG.GEMINI_MODELS.length; modelIndex++) {
    const model = CONFIG.GEMINI_MODELS[modelIndex];
    for (let retry = 0; retry < CONFIG.MODEL_RETRIES; retry++) {
      totalAttempts++;
      try {
        const response = callGemini(apiKey, model, prompt);
        const text = extractGeminiText(response);
        if (!text) throw new Error("Gemini ne khaali jawab diya.");
        const parsed = parseGeminiJSON(text);
        if (!parsed) throw new Error("Gemini ne ghalat JSON diya.");
        const direction = normalizeDirection(parsed.direction);
        if (!direction) throw new Error("Gemini ne ghalat simt di.");
        let confidence = Number(parsed.confidence);
        if (!Number.isFinite(confidence)) confidence = 55;
        confidence = clamp(confidence, 20, 95);
        return {
          direction: direction, confidence: Math.round(confidence),
          reasoning: String(parsed.reasoning || "Gemini analysis mukammal hua."),
          waitForPick: sanitizeWaitForPick(parsed.waitFor),
          model: model, attempts: totalAttempts, status: "GEMINI_AI"
        };
      } catch (error) {
        lastError = String(error.message || error);
        const statusCode = extractHttpStatus(error);
        if (statusCode === 401 || statusCode === 403) {
          return { direction: null, confidence: 40, reasoning: "Gemini API tasdeeq ki kharabi: " + lastError, model: model, attempts: totalAttempts, status: "GEMINI_API_KEY_ERROR" };
        }
        if (statusCode === 400 || statusCode === 404) break;
        if (isRetryableGeminiError(statusCode, lastError)) {
          if (retry < CONFIG.MODEL_RETRIES - 1) { Utilities.sleep(CONFIG.RETRY_DELAYS[Math.min(retry, CONFIG.RETRY_DELAYS.length - 1)]); continue; }
        }
      }
    }
  }
  return { direction: null, confidence: 40, reasoning: "Tamam Gemini models nakam. " + lastError, model: "technical-fallback", attempts: totalAttempts, status: "TECHNICAL_FALLBACK" };
}

function callGemini(apiKey, model, prompt) {
  const url = "https://generativelanguage.googleapis.com/v1beta/models/" + encodeURIComponent(model) + ":generateContent";
  const payload = {
    contents: [{ role: "user", parts: [{ text: prompt }] }],
    generationConfig: {
      temperature: 0.1, responseMimeType: "application/json",
      responseSchema: {
        type: "OBJECT",
        properties: {
          direction: { type: "STRING", enum: ["LONG", "SHORT", "NO_TRADE"] },
          confidence: { type: "NUMBER" },
          reasoning: { type: "STRING" },
          waitFor: { type: "OBJECT", properties: { resistance: { type: "STRING" }, support: { type: "STRING" }, reason: { type: "STRING" } } }
        },
        required: ["direction", "confidence", "reasoning"]
      }
    }
  };
  const response = UrlFetchApp.fetch(url, {
    method: "post", contentType: "application/json",
    headers: { "x-goog-api-key": apiKey },
    payload: JSON.stringify(payload), muteHttpExceptions: true
  });
  const status = response.getResponseCode();
  const body = response.getContentText();
  if (status < 200 || status >= 300) {
    const error = new Error("Gemini HTTP " + status + ": " + body.substring(0, 1200));
    error.httpStatus = status;
    throw error;
  }
  return JSON.parse(body);
}

function extractGeminiText(response) {
  try {
    if (response && response.candidates && response.candidates.length > 0) {
      const candidate = response.candidates[0];
      if (candidate.content && candidate.content.parts) {
        return candidate.content.parts.map(function(p) { return p.text || ""; }).join("").trim();
      }
    }
  } catch (e) {}
  return "";
}

function parseGeminiJSON(text) {
  try {
    let clean = String(text).trim().replace(/^```json\s*/i, "").replace(/^```\s*/i, "").replace(/\s*```$/i, "").trim();
    const start = clean.indexOf("{");
    const end = clean.lastIndexOf("}");
    if (start === -1 || end === -1 || end <= start) return null;
    clean = clean.substring(start, end + 1);
    const parsed = JSON.parse(clean);
    return { direction: normalizeDirection(parsed.direction), confidence: numSigned(parsed.confidence), reasoning: String(parsed.reasoning || ""), waitFor: parsed.waitFor };
  } catch (e) { return null; }
}

