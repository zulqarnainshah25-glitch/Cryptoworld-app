function fetchMarketNews() {
  const cache = CacheService.getScriptCache();
  const cached = cache.get("binance_news");
  if (cached) return cached;
  try {
    const url = "https://www.binance.com/bapi/composite/v1/public/cms/article/list/query?type=1&pageNo=1&pageSize=5";
    const options = { muteHttpExceptions: true, headers: { "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36" } };
    const response = UrlFetchApp.fetch(url, options);
    if (response.getResponseCode() === 200) {
      const json = JSON.parse(response.getContentText());
      let articlesList = [];
      if (json && json.data && json.data.catalogs && json.data.catalogs.length > 0) {
        json.data.catalogs.forEach(function(catalog) { if (catalog.articles && catalog.articles.length > 0) articlesList = articlesList.concat(catalog.articles); });
      } else if (json && json.data && json.data.articles) { articlesList = json.data.articles; }
      if (articlesList.length > 0) {
        const headlines = articlesList.slice(0, 3).map(function(a) { return a.title; }).join(" | ");
        cache.put("binance_news", headlines, CONFIG.CACHE_TTL_NEWS);
        return headlines;
      }
    }
  } catch (e) { Logger.log("News fetch exception: " + e.message); }
  return "No recent major macro news detected.";
}

