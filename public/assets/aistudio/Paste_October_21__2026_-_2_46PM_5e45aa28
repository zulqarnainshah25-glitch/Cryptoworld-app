// ==================== Utilities ====================
function getCandleHL(c) {
  if (Array.isArray(c)) return { h: Number(c[2]) || 0, l: Number(c[3]) || 0 };
  if (c && typeof c === "object") return { h: Number(c.high || c.h) || 0, l: Number(c.low || c.l) || 0 };
  return { h: 0, l: 0 };
}

function waitForRound(value) { const n = Number(value); return Number.isFinite(n) ? Number(n.toPrecision(8)) : 0; }

function waitForFormat(value) {
  const n = Number(value);
  if (!Number.isFinite(n)) return "0";
  const a = Math.abs(n);
  if (a >= 1000) return n.toFixed(0);
  if (a >= 100) return n.toFixed(1);
  if (a >= 1) return n.toFixed(3);
  if (a >= 0.01) return n.toFixed(5);
  if (a === 0) return "0";
  return n.toFixed(Math.min(12, Math.max(6, 3 - Math.floor(Math.log10(a)))));
}

const WAIT_MAX_ATR_DIST = 3;

function waitDedupe(levels, gap) {
  const out = [];
  for (let i = 0; i < levels.length; i++) {
    if (!out.length || Math.abs(levels[i] - out[out.length - 1]) >= gap) out.push(levels[i]);
  }
  return out;
}

function getWaitCandidates(market) {
  const price = market.currentPrice;
  if (!validPositive(price)) return null;
  const candles = (market.recentCandles || []).map(getCandleHL).filter(function(c) { return c.h > 0 && c.l > 0; });
  if (candles.length < 10) return null;
  let atr = market.atr;
  if (!validPositive(atr)) {
    const last14 = candles.slice(-14);
    atr = last14.reduce(function(sum, c) { return sum + (c.h - c.l); }, 0) / last14.length;
  }
  if (!validPositive(atr)) return null;
  const K = 2;
  const pivotHighs = [], pivotLows = [];
  for (let i = K; i <= candles.length - 2 - K; i++) {
    let isHigh = true, isLow = true;
    for (let j = 1; j <= K; j++) {
      if (candles[i].h <= candles[i - j].h || candles[i].h <= candles[i + j].h) isHigh = false;
      if (candles[i].l >= candles[i - j].l || candles[i].l >= candles[i + j].l) isLow = false;
    }
    if (isHigh) pivotHighs.push(candles[i].h);
    if (isLow) pivotLows.push(candles[i].l);
  }
  const minGap = atr * 0.3;
  const maxDist = atr * WAIT_MAX_ATR_DIST;
  const above = pivotHighs.filter(function(h) { return h > price + minGap && h - price <= maxDist; }).sort(function(a, b) { return a - b; });
  const below = pivotLows.filter(function(l) { return l < price - minGap && price - l <= maxDist; }).sort(function(a, b) { return b - a; });
  const resistances = waitDedupe(above, minGap).slice(0, 3);
  const supports = waitDedupe(below, minGap).slice(0, 3);
  let resCapped = false, supCapped = false;
  const recent = candles.slice(-21, -1);
  if (!resistances.length) {
    resCapped = true;
    const nearHighs = recent.map(function(c) { return c.h; }).filter(function(h) { return h > price + minGap && h - price <= maxDist; }).sort(function(a, b) { return a - b; });
    resistances.push(nearHighs.length ? nearHighs[0] : price + atr * 2);
  }
  if (!supports.length) {
    supCapped = true;
    const nearLows = recent.map(function(c) { return c.l; }).filter(function(l) { return l < price - minGap && price - l <= maxDist; }).sort(function(a, b) { return b - a; });
    supports.push(nearLows.length ? nearLows[0] : Math.max(price - atr * 2, price * 0.0001));
  }
  return { price: price, atr: atr, resistances: resistances, supports: supports, resCapped: resCapped, supCapped: supCapped };
}

function buildWaitCandidatesText(market) {
  try {
    const cand = getWaitCandidates(market);
    if (!cand) return "";
    const out = [];
    cand.resistances.forEach(function(v, i) { out.push("R" + (i + 1) + " = " + waitForFormat(v) + " (" + ((v - cand.price) / cand.atr).toFixed(1) + " ATR upar)"); });
    cand.supports.forEach(function(v, i) { out.push("S" + (i + 1) + " = " + waitForFormat(v) + " (" + ((cand.price - v) / cand.atr).toFixed(1) + " ATR neeche)"); });
    return out.join("\n");
  } catch (e) { return ""; }
}

function sanitizeWaitForPick(w) {
  if (!w || typeof w !== "object") return null;
  const r = /^R[1-3]$/.exec(String(w.resistance || "").trim().toUpperCase());
  const sp = /^S[1-3]$/.exec(String(w.support || "").trim().toUpperCase());
  let reason = String(w.reason || "").replace(/[<>]/g, "").replace(/\s+/g, " ").trim();
  if (reason.length > 300) reason = reason.substring(0, 300);
  if (!r && !sp && !reason) return null;
  return { resistance: r ? r[0] : "", support: sp ? sp[0] : "", reason: reason };
}

function calculateWaitFor(market, direction) {
  try {
    const cand = getWaitCandidates(market);
    if (!cand) return null;
    const price = cand.price, atr = cand.atr;
    const resCapped = cand.resCapped, supCapped = cand.supCapped;
    const MAX_ATR_DIST = WAIT_MAX_ATR_DIST;
    const pick = market.waitForPick || null;
    let resIdx = 0, supIdx = 0;
    if (pick) {
      const rm = /^R([1-3])$/.exec(pick.resistance || "");
      const sm = /^S([1-3])$/.exec(pick.support || "");
      if (rm && cand.resistances[Number(rm[1]) - 1] !== undefined) resIdx = Number(rm[1]) - 1;
      if (sm && cand.supports[Number(sm[1]) - 1] !== undefined) supIdx = Number(sm[1]) - 1;
    }
    const resistance = cand.resistances[resIdx];
    const support = cand.supports[supIdx];
    const aiReason = pick && pick.reason ? pick.reason : "";
    const buffer = atr * 0.15;
    const longTrigger = resistance + buffer;
    const shortTrigger = Math.max(support - buffer, 0);
    let bias = "NEUTRAL";
    if (validPositive(market.ema20) && validPositive(market.ema50)) {
      if (price < market.ema50 && market.ema20 < market.ema50) bias = "BEARISH";
      else if (price > market.ema50 && market.ema20 > market.ema50) bias = "BULLISH";
    }
    const rejectionZone = bias === "BEARISH" ? { low: Math.max(resistance - atr * 0.6, 0), high: resistance } : null;
    const pullbackZone = bias === "BULLISH" ? { low: support, high: support + atr * 0.6 } : null;
    const VOL_NEEDED = 1.2;
    const volNow = Number(market.volumeRatio) || 0;
    const volTxt = " + volume " + VOL_NEEDED + "x ya zyada";
    const lines = [];
    const tfLabel = String(market.timeframe || "1h");
    let longLine = "LONG: " + tfLabel + " candle " + waitForFormat(longTrigger) + " ke upar close ho" + volTxt;
    if (pullbackZone) longLine += ", ya " + waitForFormat(pullbackZone.low) + "-" + waitForFormat(pullbackZone.high) + " par support hold kare (neeche wick + wapas upar close)";
    lines.push(longLine);
    let shortLine = "SHORT: " + tfLabel + " candle " + waitForFormat(shortTrigger) + " ke neeche close ho" + volTxt;
    if (rejectionZone) shortLine += ", ya " + waitForFormat(rejectionZone.low) + "-" + waitForFormat(rejectionZone.high) + " par rejection aaye (upar wick + wapas neeche close) aur volume barhe";
    lines.push(shortLine);
    if (volNow > 0) {
      if (volNow < 1.0) lines.push("Abhi volume " + volNow.toFixed(2) + "x hai, trade ke liye kam. Pehle volume barhne ka wait karein.");
      else lines.push("Volume " + volNow.toFixed(2) + "x hai (theek). Ab sirf level ke break ya rejection ka intezar hai.");
    }
    if (CONFIG.BREAKOUT_MODE) lines.push("Candle close + volume 1.2x ke saath breakout confirm ho jaye to ADX ki shart nahi lagti — tab dobara Analyze dabayein.");
    if (aiReason) lines.push("AI ki raye: " + aiReason);
    if (resCapped || supCapped) lines.push("Note: " + MAX_ATR_DIST + " ATR ke andar asli swing level nahi mila, isliye nazdeeki ATR-based level dikhaya gaya hai.");
    lines.push("Setup cancel: " + waitForFormat(support) + " ke neeche LONG idea khatam, " + waitForFormat(longTrigger) + " ke upar SHORT idea khatam.");
    return {
      bias: bias, resistance: waitForRound(resistance), support: waitForRound(support),
      longTrigger: waitForRound(longTrigger), shortTrigger: waitForRound(shortTrigger),
      rejectionZone: rejectionZone ? { low: waitForRound(rejectionZone.low), high: waitForRound(rejectionZone.high) } : null,
      pullbackZone: pullbackZone ? { low: waitForRound(pullbackZone.low), high: waitForRound(pullbackZone.high) } : null,
      capped: !!(resCapped || supCapped), aiPicked: !!(pick && (pick.resistance || pick.support)),
      aiReason: aiReason, volumeNeeded: VOL_NEEDED, volumeNow: waitForRound(volNow), lines: lines
    };
  } catch (e) { Logger.log("calculateWaitFor error: " + e.message); return null; }
}

function normalizeDirection(value) {
  const d = String(value || "").trim().toUpperCase();
  if (d === "LONG" || d === "BUY" || d === "BULLISH") return "LONG";
  if (d === "SHORT" || d === "SELL" || d === "BEARISH") return "SHORT";
  if (d === "NO_TRADE" || d === "NOTRADE" || d === "NO TRADE") return "NO_TRADE";
  return null;
}

function num(value) { const n = Number(value); return Number.isFinite(n) ? n : 0; }
function numSigned(value) { const n = Number(value); return Number.isFinite(n) ? n : 0; }

function firstFiniteNumber(values) {
  for (let i = 0; i < values.length; i++) { const n = Number(values[i]); if (Number.isFinite(n)) return n; }
  return 0;
}

function getFirstDefinedValue(values) {
  for (let i = 0; i < values.length; i++) { if (values[i] !== undefined && values[i] !== null && values[i] !== "") return values[i]; }
  return 0;
}

function firstValidNumber(values) {
  for (let i = 0; i < values.length; i++) { const n = Number(values[i]); if (Number.isFinite(n) && n > 0) return n; }
  return 0;
}

function validPositive(value) { return (Number.isFinite(Number(value)) && Number(value) > 0); }
function clamp(value, min, max) { return Math.min(Math.max(value, min), max); }

function roundNumber(value, decimals) {
  const factor = Math.pow(10, decimals);
  return Math.round(value * factor) / factor;
}

function extractHttpStatus(error) {
  if (error && error.httpStatus) return Number(error.httpStatus);
  const match = String(error && error.message ? error.message : error).match(/HTTP\s+(\d{3})/i);
  return match ? Number(match[1]) : 0;
}

function isRetryableGeminiError(statusCode, message) {
  if ([429, 500, 502, 503, 504].includes(statusCode)) return true;
  const text = String(message || "").toLowerCase();
  return (text.includes("high demand") || text.includes("temporarily unavailable") || text.includes("overloaded") || text.includes("rate limit") || text.includes("resource exhausted"));
}

function jsonResponse(object) {
  return ContentService.createTextOutput(JSON.stringify(object)).setMimeType(ContentService.MimeType.JSON);
}

// ==================== Referral System ====================
function generateReferralCode(username) {
  const clean = String(username || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
  const prefix = clean.substring(0, 4).padEnd(4, "X");
  let hash = 0;
  for (let i = 0; i < username.length; i++) { hash = ((hash << 5) - hash) + username.charCodeAt(i); hash = hash & hash; }
  const suffix = Math.abs(hash).toString(36).toUpperCase().substring(0, 4).padEnd(4, "0");
  return prefix + suffix;
}

function findUserByReferralCode(quotaSheet, code) {
  const lastRow = quotaSheet.getLastRow();
  if (lastRow < 2) return null;
  const colMap = getQuotaColumnMap(quotaSheet);
  if (!colMap.ReferralCode) return null;
  const maxCol = Math.max(quotaSheet.getLastColumn(), 1);
  const values = quotaSheet.getRange(2, 1, lastRow - 1, maxCol).getValues();
  const searchCode = String(code).trim().toUpperCase();
  for (let i = 0; i < values.length; i++) {
    const rowCode = String(values[i][colMap.ReferralCode - 1] || "").trim().toUpperCase();
    if (rowCode === searchCode) {
      return { row: i + 2, username: String(values[i][0] || "").trim(), referralCount: colMap.ReferralCount ? Number(values[i][colMap.ReferralCount - 1]) || 0 : 0, referralBonus: colMap.ReferralBonus ? Number(values[i][colMap.ReferralBonus - 1]) || 0 : 0 };
    }
  }
  return null;
}

function processReferralReward(ss, referredUsername) {
  const refSheet = getOrCreateReferralsSheet(ss);
  const lastRow = refSheet.getLastRow();
  if (lastRow < 2) return;
  const values = refSheet.getRange(2, 1, lastRow - 1, REFERRAL_HEADERS.length).getValues();
  for (let i = 0; i < values.length; i++) {
    const row = values[i];
    const referredUser = String(row[3] || "").trim().toLowerCase();
    const status = String(row[4] || "").toUpperCase();
    if (referredUser !== referredUsername.toLowerCase()) continue;
    if (status === "REWARDED") continue;
    if (status !== "PENDING") continue;
    const referrerName = String(row[1] || "").trim();
    const quotaSheet = getOrCreateQuotaSheet(ss);
    const referrer = getUserQuotaRow(quotaSheet, referrerName);
    if (!referrer) { refSheet.getRange(i + 2, 5).setValue("INVALID_REFERRER"); continue; }
    if ((referrer.referralCount || 0) >= CONFIG.REFERRAL_MAX) { refSheet.getRange(i + 2, 5).setValue("MAX_REACHED"); continue; }
    const colMap = getQuotaColumnMap(quotaSheet);
    const newCount = (referrer.referralCount || 0) + 1;
    const newBonus = (referrer.referralBonus || 0) + CONFIG.REFERRAL_BONUS;
    const lock = LockService.getScriptLock();
    lock.waitLock(10000);
    try {
      if (colMap.ReferralCount) quotaSheet.getRange(referrer.row, colMap.ReferralCount).setValue(newCount);
      if (colMap.ReferralBonus) quotaSheet.getRange(referrer.row, colMap.ReferralBonus).setValue(newBonus);
      if (colMap.Signals_Left) {
        const current = Number(quotaSheet.getRange(referrer.row, colMap.Signals_Left).getValue()) || 0;
        quotaSheet.getRange(referrer.row, colMap.Signals_Left).setValue(current + CONFIG.REFERRAL_BONUS);
      }
      CacheService.getScriptCache().remove("user_" + referrerName.toLowerCase());
    } finally { lock.releaseLock(); }
    refSheet.getRange(i + 2, 5).setValue("REWARDED");
    refSheet.getRange(i + 2, 6).setValue(CONFIG.REFERRAL_BONUS);
    Logger.log("✅ Referral reward: " + referrerName + " ko +" + CONFIG.REFERRAL_BONUS + " signals (" + referredUsername + " se)");
  }
}

