function calculateSmartTradeLevels(market, direction, structure, timeframe) {
  const entry = market.currentPrice;
  let atr = market.atr;
  if (!validPositive(atr)) atr = entry * (timeframe === "15m" ? 0.004 : (timeframe === "4h" ? 0.012 : 0.006));
  const atrMultiplier = timeframe === "15m" ? 1.15 : (timeframe === "4h" ? 1.40 : 1.25);
  const maxRiskPercent = timeframe === "15m" ? 0.60 : (timeframe === "4h" ? 1.50 : 0.75);
  let stopLoss = 0, slMethod = "ATR";
  let takeProfit = 0, tpMethod = "Dynamic-ATR";
  const SL_BUFFER_ATR = 0.30;
  if (direction === "LONG" && validPositive(structure.support) && structure.support < entry) {
    let structuralSL = structure.support - atr * SL_BUFFER_ATR;
    structuralSL = Math.min(structuralSL, entry - atr * CONFIG.MIN_SL_ATR);
    if ((entry - structuralSL) <= (entry * (maxRiskPercent / 100))) { stopLoss = structuralSL; slMethod = "structural-support"; }
  }
  if (direction === "SHORT" && validPositive(structure.resistance) && structure.resistance > entry) {
    let structuralSL = structure.resistance + atr * SL_BUFFER_ATR;
    structuralSL = Math.max(structuralSL, entry + atr * CONFIG.MIN_SL_ATR);
    if ((structuralSL - entry) <= (entry * (maxRiskPercent / 100))) { stopLoss = structuralSL; slMethod = "structural-resistance"; }
  }
  if (!validPositive(stopLoss)) {
    stopLoss = direction === "LONG" ? (entry - atr * atrMultiplier) : (entry + atr * atrMultiplier);
    slMethod = "ATR-" + atrMultiplier;
  }
  let risk = Math.abs(entry - stopLoss);
  const bo = (CONFIG.BREAKOUT_MODE && market.breakouts) ? market.breakouts[direction] : null;
  if (bo && validPositive(bo.level)) {
    let boSL = direction === "LONG" ? bo.level - atr * 0.30 : bo.level + atr * 0.30;
    boSL = direction === "LONG" ? Math.min(boSL, entry - atr * CONFIG.MIN_SL_ATR) : Math.max(boSL, entry + atr * CONFIG.MIN_SL_ATR);
    if (Math.abs(entry - boSL) <= entry * (maxRiskPercent / 100)) { stopLoss = boSL; slMethod = "breakout-level"; risk = Math.abs(entry - stopLoss); }
  }
  const TP_BUFFER_ATR = 0.15;
  if (direction === "LONG" && validPositive(structure.resistance) && structure.resistance > entry) {
    const structuralTP = structure.resistance - atr * TP_BUFFER_ATR;
    if (structuralTP > entry + atr * 0.5) { takeProfit = structuralTP; tpMethod = "structural-resistance"; }
  }
  if (direction === "SHORT" && validPositive(structure.support) && structure.support < entry) {
    const structuralTP = structure.support + atr * TP_BUFFER_ATR;
    if (structuralTP < entry - atr * 0.5) { takeProfit = structuralTP; tpMethod = "structural-support"; }
  }
  if (!validPositive(takeProfit)) {
    let tpMultiplier = 2.0;
    if (market.adx >= 30) tpMultiplier = 3.0; else if (market.adx >= 25) tpMultiplier = 2.5; else if (market.adx >= 20) tpMultiplier = 2.0; else tpMultiplier = 1.5;
    takeProfit = direction === "LONG" ? entry + atr * tpMultiplier : entry - atr * tpMultiplier;
    tpMethod = "ATR-" + tpMultiplier;
  }
  if (bo && risk > 0) { takeProfit = direction === "LONG" ? entry + risk * CONFIG.BREAKOUT_RR : entry - risk * CONFIG.BREAKOUT_RR; tpMethod = "breakout-" + CONFIG.BREAKOUT_RR + "R"; }
  if (risk > 0 && Math.abs(takeProfit - entry) > risk * CONFIG.MAX_RR) {
    takeProfit = direction === "LONG" ? entry + risk * CONFIG.MAX_RR : entry - risk * CONFIG.MAX_RR;
    tpMethod = tpMethod + "-capped";
  }
  const reward = Math.abs(takeProfit - entry);
  const rr = risk > 0 ? reward / risk : 0;
  const roomToTP = reward;
  const tpDistanceATR = atr > 0 ? (reward / atr) : 0;
  const insufficientRoom = tpDistanceATR < 1.0;
  let suggestedEntry = entry;
  let triggerPrice = entry;
  let invalidationPrice = stopLoss;
  if (direction === "LONG" && validPositive(market.ema20) && market.ema20 < entry && market.ema20 > stopLoss) {
    const ema20Pullback = market.ema20 + atr * 0.10;
    if (ema20Pullback < entry && ema20Pullback > stopLoss) { suggestedEntry = ema20Pullback; triggerPrice = ema20Pullback; }
  }
  if (direction === "SHORT" && validPositive(market.ema20) && market.ema20 > entry && market.ema20 < stopLoss) {
    const ema20Pullback = market.ema20 - atr * 0.10;
    if (ema20Pullback > entry && ema20Pullback < stopLoss) { suggestedEntry = ema20Pullback; triggerPrice = ema20Pullback; }
  }
  const suggestedRisk = Math.abs(suggestedEntry - stopLoss);
  const suggestedReward = Math.abs(takeProfit - suggestedEntry);
  const suggestedRR = suggestedRisk > 0 ? suggestedReward / suggestedRisk : 0;
  return {
    entry: entry, stopLoss: stopLoss, takeProfit: takeProfit, risk: risk, reward: reward, rr: rr,
    riskPercent: (risk / entry) * 100, slMethod: slMethod, tpMethod: tpMethod,
    roomToTP: roomToTP, tpDistanceATR: tpDistanceATR, insufficientRoom: insufficientRoom,
    currentPrice: entry, suggestedEntry: suggestedEntry, triggerPrice: triggerPrice,
    invalidationPrice: invalidationPrice, suggestedRR: suggestedRR, entryImproved: suggestedEntry !== entry
  };
}

