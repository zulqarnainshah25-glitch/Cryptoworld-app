function generateUniquePremiumCode(codesSheet, planType) {
  const prefix = planType.substring(0, 3);
  let attempts = 0, code;
  while (attempts < 10) {
    const random = Utilities.getUuid().substring(0, 8).toUpperCase().replace(/-/g, "");
    code = prefix + "-" + random;
    if (!codeExistsInSheet(codesSheet, code)) return code;
    attempts++;
  }
  return prefix + "-" + Date.now().toString(36).toUpperCase().substring(0, 8);
}

