  const signalQuality = calculateSignalQuality(market, direction);

  if (finalConfidence < CONFIG.MIN_CONFIDENCE) {
    const remaining = consumePartialQuota(quotaSheet, userQuota.row, userQuota.signalsLeft, CONFIG.NO_TRADE_QUOTA_COST);
    warnings.push("[SAFETY] Confidence bohat kam (" + finalConfidence + "%), signal mustarad.");

