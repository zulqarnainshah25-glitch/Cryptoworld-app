// ==================== Share Reward System ====================
function handleShareClaim(data) {
  const username = SECURITY.sanitizeString(data.username || data.userId || "", 50).trim();
  const platform = SECURITY.sanitizeString(data.platform || "", 20).trim().toLowerCase();
  const shareToken = SECURITY.sanitizeString(data.shareToken || "", 64).trim();
  const deviceId = SECURITY.sanitizeString(data.deviceId || "", 128).trim();
  if (!username) return jsonResponse({ error: true, message: "Username darkar hai." });
  if (!platform) return jsonResponse({ error: true, message: "Platform darkar hai." });
  const allowedPlatforms = ["whatsapp", "twitter", "facebook", "telegram"];
  if (allowedPlatforms.indexOf(platform) === -1) return jsonResponse({ error: true, message: "Platform valid nahi." });
  const ss = getSpreadsheet();
  const quotaSheet = getOrCreateQuotaSheet(ss);
  const user = getUserQuotaRow(quotaSheet, username);
  if (!user) return jsonResponse({ error: true, message: "User nahi mila." });
  const sharesSheet = getOrCreateSharesSheet(ss);
  const lastRow = sharesSheet.getLastRow();
  const now = new Date();
  const nowMs = now.getTime();
  const oneDayAgo = nowMs - (CONFIG.SHARE_COOLDOWN_HOURS * 60 * 60 * 1000);
  const monthStart = new Date(now.getFullYear(), now.getMonth(), 1).getTime();
  let todayCount = 0, monthCount = 0;
  const platformLastShare = {};
  if (lastRow >= 2) {
    const values = sharesSheet.getRange(2, 1, lastRow - 1, SHARE_HEADERS.length).getValues();
    for (let i = 0; i < values.length; i++) {
      const rowUser = String(values[i][1] || "").trim().toLowerCase();
      if (rowUser !== username.toLowerCase()) continue;
      const ts = values[i][0] instanceof Date ? values[i][0].getTime() : new Date(values[i][0]).getTime();
      if (isNaN(ts)) continue;
      const platformRow = String(values[i][2] || "").trim().toLowerCase();
      if (ts >= monthStart) monthCount++;
      if (ts >= oneDayAgo) {
        todayCount++;
        if (!platformLastShare[platformRow] || ts > platformLastShare[platformRow]) platformLastShare[platformRow] = ts;
      }
    }
  }
  if (todayCount >= CONFIG.SHARE_MAX_PER_DAY) return jsonResponse({ error: true, message: "Aaj ki share limit khatam ho gayi. Kal dobara koshish karein.", todayCount: todayCount, maxPerDay: CONFIG.SHARE_MAX_PER_DAY });
  if (monthCount >= CONFIG.SHARE_MAX_PER_MONTH) return jsonResponse({ error: true, message: "Is mahine ki share limit khatam ho gayi.", monthCount: monthCount, maxPerMonth: CONFIG.SHARE_MAX_PER_MONTH });
  if (platformLastShare[platform]) {
    const elapsed = nowMs - platformLastShare[platform];
    if (elapsed < CONFIG.SHARE_COOLDOWN_HOURS * 60 * 60 * 1000) {
      const hoursLeft = Math.ceil((CONFIG.SHARE_COOLDOWN_HOURS * 60 * 60 * 1000 - elapsed) / (60 * 60 * 1000));
      return jsonResponse({ error: true, message: "Is platform par dobara share karne ke liye " + hoursLeft + " ghante intezar karein.", hoursLeft: hoursLeft });
    }
  }
  if (shareToken && lastRow >= 2) {
    const tokens = sharesSheet.getRange(2, 4, lastRow - 1, 1).getValues();
    for (let i = 0; i < tokens.length; i++) {
      if (String(tokens[i][0] || "").trim() === shareToken) return jsonResponse({ error: true, message: "Yeh share pehle claim ho chuka hai." });
    }
  }
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    sharesSheet.appendRow([now, username, platform, shareToken, CONFIG.SHARE_REWARD, deviceId]);
    const colMap = getQuotaColumnMap(quotaSheet);
    if (colMap.Signals_Left) {
      const current = Number(quotaSheet.getRange(user.row, colMap.Signals_Left).getValue()) || 0;
      quotaSheet.getRange(user.row, colMap.Signals_Left).setValue(current + CONFIG.SHARE_REWARD);
    }
    CacheService.getScriptCache().remove("user_" + username.toLowerCase());
  } finally { lock.releaseLock(); }
