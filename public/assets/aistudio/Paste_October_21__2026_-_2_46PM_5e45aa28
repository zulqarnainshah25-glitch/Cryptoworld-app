  const reasoning = buildReasoning(market, direction, structure, trade, aiResult.reasoning, technicalFallback);
  const remainingSignals = consumeQuota(quotaSheet, userQuota.row, userQuota.signalsLeft);

  appendJournal(journalSheet, market.marketTimestamp, symbol, timeframe, direction, finalConfidence,
    aiResult.confidence, technicalConfidence, trade, market, structure,
