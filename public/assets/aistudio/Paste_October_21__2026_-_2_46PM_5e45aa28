// ==================== Market Data Normalization ====================
function normalizeTF(value) {
  const v = String(value || "").toLowerCase().trim();
  if (v === "15m" || v === "15min" || v === "15") return "15m";
  if (v === "4h" || v === "4hr" || v === "4hour") return "4h";
  return "1h";
}

function normalizeTFData(data) {
  data = data || {};
  return {
    rsi: clamp(num(data.rsi), 0, 100),
    macd: numSigned(data.macd),
    macdSignal: numSigned(getFirstDefinedValue([data.macdSignal, data.macd_signal])),
    macdHistogram: numSigned(getFirstDefinedValue([data.macdHistogram, data.macd_histogram])),
    adx: clamp(num(data.adx), 0, 100),
    atr: Math.max(0, num(data.atr)),
    volumeRatio: Math.max(0, num(getFirstDefinedValue([data.volumeRatio, data.volume_ratio]))),
    ema20: num(getFirstDefinedValue([data.ema20, data.ema_20])),
    ema50: num(getFirstDefinedValue([data.ema50, data.ema_50])),
    ema200: num(getFirstDefinedValue([data.ema200, data.ema_200])),
    sma20: num(getFirstDefinedValue([data.sma20, data.sma_20])),
    sma50: num(getFirstDefinedValue([data.sma50, data.sma_50])),
    support: Math.max(0, num(data.support)),
    resistance: Math.max(0, num(data.resistance))
  };
}

function normalizeMarketData(data, timeframe) {
  const tf1 = normalizeTFData(data.tf1 || {});
  const tf2 = normalizeTFData(data.tf2 || {});
  const tf3 = normalizeTFData(data.tf3 || {});
  const source = data.market || data.indicators || data;
  const currentPrice = firstValidNumber([source.currentPrice, source.price, data.currentPrice, data.price]);
  const rsi = firstValidNumber([source.rsi, tf1.rsi]);
  const macd = firstFiniteNumber([source.macd, tf1.macd]);
  const macdSignal = firstFiniteNumber([source.macdSignal, source.macd_signal, tf1.macdSignal]);
  let macdHistogram = firstFiniteNumber([source.macdHistogram, source.macd_histogram, tf1.macdHistogram]);
  if (!Number.isFinite(Number(macdHistogram)) || (Number(macdHistogram) === 0 && (Number(macd) !== 0 || Number(macdSignal) !== 0))) {
    macdHistogram = macd - macdSignal;
  }
  const rawCandles = data.recentCandles || data.candles || [];
  const candles = Array.isArray(rawCandles) ? rawCandles.slice(-CONFIG.MAX_CANDLES) : [];
  const clientTs = data.marketTimestamp ? new Date(data.marketTimestamp).getTime() : 0;
  const now = Date.now();
  const marketTs = (clientTs > 0 && Math.abs(now - clientTs) < 60000) ? new Date(clientTs) : new Date();
  return {
    currentPrice: num(currentPrice), marketTimestamp: marketTs, recentCandles: candles,
    rsi: clamp(num(rsi), 0, 100), macd: numSigned(macd), macdSignal: numSigned(macdSignal),
    macdHistogram: numSigned(macdHistogram),
    adx: clamp(num(firstValidNumber([source.adx, tf1.adx])), 0, 100),
    atr: Math.max(0, num(firstValidNumber([source.atr, tf1.atr]))),
    volumeRatio: Math.max(0, num(firstValidNumber([source.volumeRatio, source.volume_ratio, tf1.volumeRatio]))),
    ema20: num(firstValidNumber([source.ema20, source.ema_20, tf1.ema20])),
    ema50: num(firstValidNumber([source.ema50, source.ema_50, tf1.ema50])),
    ema200: num(firstValidNumber([source.ema200, source.ema_200, tf1.ema200])),
    sma20: num(firstValidNumber([source.sma20, source.sma_20, tf1.sma20])),
    sma50: num(firstValidNumber([source.sma50, source.sma_50, tf1.sma50])),
    support: Math.max(0, num(firstValidNumber([source.support, tf1.support]))),
    resistance: Math.max(0, num(firstValidNumber([source.resistance, tf1.resistance]))),
    tf1: tf1, tf2: tf2, tf3: tf3
  };
}

function fallbackDirection(market) {
  let bullish = 0, bearish = 0, bullishStrong = 0, bearishStrong = 0;
  if (validPositive(market.currentPrice) && validPositive(market.ema20)) {
    if (market.currentPrice > market.ema20) { bullish += 2; bullishStrong++; } else if (market.currentPrice < market.ema20) { bearish += 2; bearishStrong++; }
  }
  if (validPositive(market.ema20) && validPositive(market.ema50)) {
    if (market.ema20 > market.ema50) { bullish += 3; bullishStrong++; } else if (market.ema20 < market.ema50) { bearish += 3; bearishStrong++; }
  }
  if (validPositive(market.currentPrice) && validPositive(market.ema50)) {
    if (market.currentPrice > market.ema50) bullish += 2; else if (market.currentPrice < market.ema50) bearish += 2;
  }
  if (Number.isFinite(Number(market.macd)) && Number.isFinite(Number(market.macdSignal))) {
    if (market.macd > market.macdSignal) { bullish += 2; bullishStrong++; } else if (market.macd < market.macdSignal) { bearish += 2; bearishStrong++; }
  }
  if (Number.isFinite(Number(market.rsi)) && market.rsi > 0) {
    if (market.rsi >= 55 && market.rsi < 70) { bullish += 2; bullishStrong++; } else if (market.rsi <= 45 && market.rsi > 30) { bearish += 2; bearishStrong++; }
  }
  let htfBullish = 0, htfBearish = 0;
  [market.tf2, market.tf3].forEach(function(tf) {
    if (!tf) return;
    if (validPositive(tf.ema20) && validPositive(tf.ema50)) {
      if (tf.ema20 > tf.ema50) htfBullish++; else if (tf.ema20 < tf.ema50) htfBearish++;
    }
    if (Number.isFinite(Number(tf.macd)) && Number.isFinite(Number(tf.macdSignal))) {
      if (tf.macd > tf.macdSignal) htfBullish++; else if (tf.macd < tf.macdSignal) htfBearish++;
    }
  });
  if (htfBullish > htfBearish) bullish += 3; else if (htfBearish > htfBullish) bearish += 3;
  if (validPositive(market.currentPrice) && validPositive(market.ema200)) {
    if (market.currentPrice > market.ema200) bullish += 2; else if (market.currentPrice < market.ema200) bearish += 2;
  }
  bullish = Math.max(0, bullish); bearish = Math.max(0, bearish);
  const totalScore = bullish + bearish;
  const scoreDifference = Math.abs(bullish - bearish);
  if (totalScore === 0 || scoreDifference < CONFIG.FALLBACK_MIN_SCORE_DIFF || Math.max(bullishStrong, bearishStrong) < 1) return "NO_TRADE";
  if (bullish > bearish && scoreDifference >= CONFIG.FALLBACK_MIN_SCORE_DIFF) return "LONG";
  if (bearish > bullish && scoreDifference >= CONFIG.FALLBACK_MIN_SCORE_DIFF) return "SHORT";
  return "NO_TRADE";
}

function detectHTFConflict(market, direction, isMacroBull, isMacroBear) {
  if (!direction || direction === "NO_TRADE") return { conflict: false };
  let conflict = false, conflictType = "";
  if (direction === "SHORT" && isMacroBull) { conflict = true; conflictType = "SHORT against BULLISH HTF"; }
  else if (direction === "LONG" && isMacroBear) { conflict = true; conflictType = "LONG against BEARISH HTF"; }
  let htfDisagreeCount = 0;
  const htfFrames = [market.tf2, market.tf3];
  htfFrames.forEach(function(tf) {
    if (!tf) return;
    const tfBull = (validPositive(tf.ema20) && validPositive(tf.ema50) && tf.ema20 > tf.ema50);
    const tfBear = (validPositive(tf.ema20) && validPositive(tf.ema50) && tf.ema20 < tf.ema50);
    if (direction === "SHORT" && tfBull) htfDisagreeCount++;
    if (direction === "LONG" && tfBear) htfDisagreeCount++;
  });
  return {
    conflict: conflict, conflictType: conflictType, htfDisagreeCount: htfDisagreeCount,
    reason: conflict ? (conflictType + " (" + htfDisagreeCount + " HTF frames disagree)") : ""
  };
}

function detectOverextension(market, direction) {
  if (!direction || direction === "NO_TRADE") return { overextended: false, severity: "NORMAL", score: 0 };
  const atr = market.atr || 0;
  const candles = market.recentCandles || [];
  const lastCandle = candles.length > 0 ? candles[candles.length - 1] : null;
  let candleRange = 0;
  if (lastCandle) {
    const hl = getCandleHL(lastCandle);
    candleRange = (hl.h > 0 && hl.l > 0) ? Math.abs(hl.h - hl.l) : 0;
  }
  const candleExtension = atr > 0 ? (candleRange / atr) : 0;
  const priceDistancePct = market.ema20 > 0 ? Math.abs(market.currentPrice - market.ema20) / market.ema20 * 100 : 0;
  const rsiExtreme = (direction === "SHORT" && market.rsi > 0 && market.rsi < 20) || (direction === "LONG" && market.rsi > 80);
  const largeCandle = candleExtension > 1.5;
  const volumeSpike = market.volumeRatio >= 2.0;
  const priceFar = priceDistancePct > 1.5;
  let score = 0;
  if (rsiExtreme) score += 1;
  if (largeCandle) score += 1;
  if (volumeSpike) score += 1;
  if (priceFar) score += 1;
  const extremeRSI = (direction === "SHORT" && market.rsi > 0 && market.rsi < 15) || (direction === "LONG" && market.rsi > 85);
  const veryLargeCandle = candleExtension > 2.5;
  const veryFarPrice = priceDistancePct > 3.0;
  if (extremeRSI) score += 1;
  if (veryLargeCandle) score += 1;
  if (veryFarPrice) score += 1;
  let severity = "NORMAL", overextended = false;
  if (score >= 5) { severity = "STRONGLY_EXTENDED"; overextended = true; }
  else if (score >= 3) { severity = "EXTENDED"; }
  let reason = "";
  if (score >= 3) {
    const parts = [];
    if (rsiExtreme) parts.push("RSI extreme (" + market.rsi.toFixed(2) + ")");
    if (largeCandle) parts.push("large candle (" + candleExtension.toFixed(2) + "× ATR)");
    if (volumeSpike) parts.push("volume spike (" + market.volumeRatio.toFixed(2) + "×)");
    if (priceFar) parts.push("price EMA20 se " + priceDistancePct.toFixed(2) + "% door");
    if (extremeRSI) parts.push("RSI very extreme");
    if (veryLargeCandle) parts.push("candle very large");
    if (veryFarPrice) parts.push("price very far from EMA20");
    reason = parts.join(", ");
  }
  return { overextended: overextended, severity: severity, score: score, candleExtension: candleExtension, priceDistancePct: priceDistancePct, rsiExtreme: rsiExtreme, largeCandle: largeCandle, volumeSpike: volumeSpike, priceFar: priceFar, reason: reason };
}
