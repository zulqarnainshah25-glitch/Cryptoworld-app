function doPost(e) {
  try {
    if (!e || !e.postData || !e.postData.contents) return jsonResponse({ error: true, message: "Koi data moosool nahi hua." });
    let data;
    try { data = JSON.parse(e.postData.contents); } catch (err) { return jsonResponse({ error: true, message: "Ghalat JSON format." }); }
    const deviceId = data.deviceId || "unknown";
    const cache = CacheService.getScriptCache();
    const rateKey = "rate_" + deviceId;
    const count = Number(cache.get(rateKey) || 0);
    if (count >= 30) return jsonResponse({ error: true, message: "Bohat zyada requests. 2 minute baad koshish karein." });
    cache.put(rateKey, count + 1, 120);
    const action = String(data.action || "").trim().toLowerCase();
