    if (action === "register") return handleRegister(data);
    if (action === "signal") return handleSignal(data);
    if (action === "quota") return handleCheckQuota(data);
    if (action === "accuracy") return handleAccuracyReport(data);
    if (action === "unlock_device") return handleUnlockDevice(data);
    if (action === "share_claim") return handleShareClaim(data);
    if (action === "submit_suggestion") return handleSubmitSuggestion(data);
    if (action === "get_my_suggestions") return handleGetMySuggestions(data);
    if (action === "redeem_premium_code") return handleRedeemPremiumCode(data);
    if (action === "check_premium") return handleCheckPremium(data);
    if (action === "get_premium_plans") return handleGetPremiumPlans(data);
    if (action === "get_referral_info") return handleGetReferralInfo(data);
    if (action === "admin_activate_premium") return handleAdminActivatePremium(data);
    if (action === "admin_create_premium_codes") return handleAdminCreatePremiumCodes(data);
    if (action === "admin_bulk_generate") return handleAdminBulkGenerate(data);
    if (action === "admin_generate_single") return handleAdminGenerateSingle(data);
    if (action === "admin_list_codes") return handleAdminListCodes(data);
